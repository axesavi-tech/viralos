  "version": "0.1.0",
  "description": "Kathavi reel engine: Remotion themes, planner, QA and the Reel Studio page served at /studio/reels/",
  "scripts": {
    "typecheck": "tsc -p .",
    "studio:build": "node scripts/build-studio.mjs",
    "preview": "remotion studio src/Root.tsx",
