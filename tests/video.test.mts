import assert from "node:assert/strict";
let n = 0; const t = async (name: string, fn: () => any) => { try { await fn(); n++; console.log("✓", name); } catch (e: any) { console.log("✗", name, e.message); process.exitCode = 1; } };

/* ---- AI footage: request builders match each provider's documented schema ---- */
const VM = await import("../lib/videoModels.ts");
const img = "https://cdn.example/p.jpg";
await t("seedance i2v: image_url, integer duration, 720p, audio", () => { const r = VM.buildRequest("seedance", { prompt: "slow push in", imageUrl: img, duration: 8, aspect: "9:16" }); assert.equal(r.provider, "fal"); assert.equal(r.endpoint, "bytedance/seedance-2.5/image-to-video"); assert.equal(r.body.image_url, img); assert.equal(r.body.duration, 8); assert.equal(r.body.resolution, "720p"); assert.match(r.body.prompt, /Keep the product exactly/); });
await t("kling 4 flash uses start_image_url and overridable model", () => { const r = VM.buildRequest("kling", { prompt: "walk", imageUrl: img, duration: 7, aspect: "9:16", overrides: { kling_model: "kling/v4/image-to-video" } }); assert.equal(r.endpoint, "kling/v4/image-to-video"); assert.equal(r.body.start_image_url, img); assert.equal(r.body.duration, 8); });
await t("wan 3.0 maps 4:5 to 3:4 and uses start_image_url", () => { const r = VM.buildRequest("wan", { prompt: "x", imageUrl: img, duration: 5, aspect: "4:5" }); assert.equal(r.endpoint, "alibaba/wan-3.0/image-to-video"); assert.equal(r.body.aspect_ratio, "3:4"); assert.equal(r.body.start_image_url, img); });
await t("veo 3.1 duration is a 4s/6s/8s string", () => { const r = VM.buildRequest("veo", { prompt: "x", imageUrl: img, duration: 7, aspect: "9:16" }); assert.equal(r.endpoint, "fal-ai/veo3.1/image-to-video"); assert.ok(["6s", "8s"].includes(r.body.duration)); assert.equal(r.body.aspect_ratio, "9:16"); });
await t("minimax h3 text-only omits image_url", () => { const r = VM.buildRequest("minimax", { prompt: "rainy café", duration: 9, aspect: "9:16" }); assert.equal(r.body.image_url, undefined); assert.equal(r.body.resolution, "768P"); assert.equal(r.body.duration, 8); });
await t("runway gen4.5 i2v: promptImage + portrait 720:1280", () => { const r = VM.buildRequest("runway", { prompt: "orbit", imageUrl: img, duration: 10, aspect: "9:16" }); assert.equal(r.provider, "runway"); assert.equal(r.endpoint, "/v1/image_to_video"); assert.equal(r.body.model, "gen4.5"); assert.equal(r.body.ratio, "720:1280"); assert.equal(r.body.promptImage, img); assert.ok(r.body.promptText.length <= 1000); });
await t("runway text-to-video only uses supported ratios", () => { const r = VM.buildRequest("runway", { prompt: "x", duration: 5, aspect: "1:1" }); assert.equal(r.endpoint, "/v1/text_to_video"); assert.equal(r.body.ratio, "720:1280"); });
await t("photo-only models refuse text-only requests", () => { assert.throws(() => VM.buildRequest("kling", { prompt: "x", duration: 5, aspect: "9:16" }), /needs a product photo/); assert.throws(() => VM.buildRequest("veo", { prompt: "x", duration: 5, aspect: "9:16" })); });
await t("omni body: parts before prompt, 9:16 response_format, synchronous", () => { const b = VM.omniBody("gemini-omni-1.1-flash", "make it evening", "9:16", [{ type: "video", data: "AAA", mime_type: "video/mp4" }]); assert.equal(b.input[0].type, "video"); assert.equal(b.input[1].text, "make it evening"); assert.equal(b.response_format.aspect_ratio, "9:16"); assert.equal(b.background, false); assert.equal(VM.omniBody("m", "p", "16:9", []).input, "p"); });
await t("omni response: finds inline video in model_output step", () => { assert.deepEqual(VM.omniVideo({ steps: [{ type: "user_input" }, { type: "model_output", content: [{ type: "text" }, { type: "video", data: "QQ==", mime_type: "video/mp4" }] }] }), { data: "QQ==", uri: undefined, mime: "video/mp4" }); assert.equal(VM.omniVideo({ steps: [] }), null); });
await t("runway task states", () => { assert.deepEqual(VM.runwayState({ status: "RUNNING" }), { state: "running" }); assert.deepEqual(VM.runwayState({ status: "SUCCEEDED", output: ["https://x/v.mp4"] }), { state: "done", url: "https://x/v.mp4" }); assert.equal((VM.runwayState({ status: "FAILED", failure: "moderation" }) as any).error, "moderation"); });
await t("durations snap to each model's allowed values; credits ≈ 3× cost", () => { assert.equal(VM.clampDuration(VM.MODELS.veo, 30), 8); assert.equal(VM.clampDuration(VM.MODELS.omni, 3), 10); for (const m of Object.values(VM.MODELS)) { const inr = m.usdPerSec * 85, credInr = m.credPerSec * 0.83; assert.ok(credInr / inr >= 2.9, m.key + " margin " + (credInr / inr).toFixed(2)); } });
await t("template tags suggest the right job", () => { assert.equal(VM.jobForTemplate({ name: "Cinematic Film" }), "film"); assert.equal(VM.jobForTemplate({ tags: ["Fashion"] }), "people"); assert.equal(VM.jobForTemplate({ name: "Price Drop" }), "hero"); });
await t("provider keys gate availability", () => { assert.equal(VM.providerConfigured("runway", {}), false); assert.equal(VM.providerConfigured("gemini", { GEMINI_API_KEY: "k" }), true); });

console.log(`\n${n} passed`);
